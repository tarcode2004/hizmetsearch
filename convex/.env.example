# ─────────────────────────────────────────────────────────────────────────
#  Convex environment variables
#
#  These are NOT loaded from this file at runtime. Set them on your Convex
#  deployment with:
#
#    npx convex env set KEY=value           # production
#    npx convex env set KEY=value --dev     # dev deployment
#
#  …or use the Convex dashboard (Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────────────────

# ── FastAPI RAG service ────────────────────────────────────────────────
RAG_API_URL=https://hizmetsearch-api.fly.dev
RAG_API_KEY=                            # same value as Fly secret RAG_API_KEY

# ── LLM providers ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                      # sk-ant-…
GEMINI_API_KEY=                         # used for ai_answer + chat (Gemini)

# ── Clerk auth ─────────────────────────────────────────────────────────
# JWT issuer URL from Clerk dashboard → JWT Templates → "convex" → Issuer.
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev

# ── Stripe ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=                      # sk_live_… or sk_test_…
STRIPE_WEBHOOK_SECRET=                  # whsec_… (from webhook endpoint config)

# Recurring subscription prices
STRIPE_PRO_PRICE_ID=                    # price_…
STRIPE_SCHOLAR_PRICE_ID=                # price_…

# One-time credit pack prices (Spark $5, Lantern $15, Minaret $50)
STRIPE_PACK_SPARK_PRICE_ID=             # price_…
STRIPE_PACK_LANTERN_PRICE_ID=           # price_…
STRIPE_PACK_MINARET_PRICE_ID=           # price_…
