# ─────────────────────────────────────────────────────────────────────────
#  HizmetSearch web app — environment variables
#
#  Copy to `.env.local` and fill in. Both vars must be set for the app to
#  use the live backend; if either is missing it falls back to the static
#  mock-data demo (still useful for UI development).
# ─────────────────────────────────────────────────────────────────────────

# Convex deployment URL — get this from `npx convex deploy` or the dashboard
# (Settings → URL & Deploy Key).
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Clerk publishable key — Clerk dashboard → API Keys → Frontend API.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_or_pk_live_...

# ── Optional: Sentry (error reporting) ──────────────────────────────────
# Leave unset in dev; the SDK no-ops when DSN is missing.
# VITE_SENTRY_DSN=https://xxx@oxxx.ingest.sentry.io/xxx
# VITE_SENTRY_ENVIRONMENT=production

# ── Optional: PostHog (product analytics) ───────────────────────────────
# Project API key from https://us.posthog.com or https://eu.posthog.com.
# Publishable — ships in browsers, OK to commit if you want.
# Leave both unset in dev; the SDK no-ops when missing.
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://us.posthog.com
